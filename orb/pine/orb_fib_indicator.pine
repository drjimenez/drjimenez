// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0
// ORB Londres / Nueva York + Fibonacci + proyección 1.618
// Dibuja el rango de apertura (15 o 20 min) de Londres y Nueva York, los retrocesos Fibonacci
// dentro del rango y las extensiones fuera de él, y marca la primera ruptura por cierre y el
// primer retest del nivel roto. Tras la ruptura proyecta la extensión 1.618 en la dirección de la
// ruptura con la probabilidad de alcanzarla, que se actualiza en vivo según el tamaño del rango y
// lo que haga el precio (si retrocede al 50 % o toca el extremo opuesto antes de llegar).
// Tabla de registro (backtesting): para la última apertura de cada bolsa muestra, por etapas
// (apertura -> cierre del rango -> ruptura), la probabilidad histórica de cada condición y si se
// cumplió (✓ / ✗). Las columnas "en el gráfico" suman todas las aperturas cargadas en el gráfico:
// probabilidad media pronosticada frente a frecuencia real.
// Probabilidades medidas en el estudio en Python (orb/), NAS100 + US500, 1 min, 2022-2026.
// Úsalo en gráficos de 1 a 5 minutos.
//@version=6
indicator("ORB Londres/NY + Fibonacci", overlay = true, max_lines_count = 500, max_labels_count = 500)

orMin = input.int(15, "Minutos del rango de apertura", options = [15, 20])

grpL = "Londres"
showLon = input.bool(true, "Mostrar Londres", group = grpL)
lonHor  = input.session("0800-1200", "Horizonte (hasta cuándo se siguen los niveles)", group = grpL)
colLon  = input.color(#2a78d6, "Color", group = grpL)

grpN = "Nueva York"
showNy = input.bool(true, "Mostrar Nueva York", group = grpN)
nyHor  = input.session("0930-1600", "Horizonte (hasta cuándo se siguen los niveles)", group = grpN)
colNy  = input.color(#eb6834, "Color", group = grpN)

grpF = "Fibonacci"
showRet   = input.bool(true, "Retrocesos dentro del rango (23.6 / 38.2 / 50 / 61.8 / 78.6)", group = grpF)
showExt   = input.bool(true, "Extensiones fuera del rango (1.272 / 1.618 / 2.0 / 2.618)", group = grpF)
showMarks = input.bool(true, "Marcar ruptura y retest", group = grpF)
showProj  = input.bool(true, "Proyección 1.618 con probabilidad", group = grpF)
colProj   = input.color(#1baf7a, "Color de la proyección", group = grpF)
showStats = input.bool(false, "Tabla de probabilidades del estudio", group = grpF)
showReg   = input.bool(true, "Tabla de registro por apertura (backtesting)", group = grpF)
regPos    = input.string("Abajo derecha", "Posición del registro", options = ["Abajo derecha", "Arriba derecha", "Abajo izquierda", "Arriba izquierda"], group = grpF)

lonOR = orMin == 15 ? "0800-0815" : "0800-0820"
nyOR  = orMin == 15 ? "0930-0945" : "0930-0950"

var RET = array.from(0.236, 0.382, 0.5, 0.618, 0.786)
var EXT = array.from(0.272, 0.618, 1.0, 1.618)

// --- Probabilidad (%) de alcanzar la extensión 1.618 tras la ruptura -------------------------
// Índice = (combo * 4 + tamaño) * 3 + estado
//   combo:  0 Londres OR15 · 1 Londres OR20 · 2 NY OR15 · 3 NY OR20
//   tamaño: 0 rango pequeño · 1 medio · 2 grande (terciles de rango OR / rango medio diario NY) · 3 sin dato
//   estado: 0 recién roto · 1 ya retrocedió al 50 % sin llegar · 2 ya tocó el extremo opuesto sin llegar
var PROB = array.from(
     83.2, 61.4, 46.1,  77.8, 53.8, 34.7,  64.0, 32.0, 14.3,  75.0, 48.5, 31.5,
     82.2, 59.3, 43.6,  71.9, 43.5, 25.2,  59.0, 24.9, 12.7,  71.0, 42.1, 27.5,
     84.5, 67.4, 52.8,  78.5, 52.9, 32.1,  68.9, 36.2, 21.1,  77.3, 52.2, 35.7,
     80.9, 61.3, 43.0,  75.2, 45.6, 22.9,  65.2, 27.5, 14.9,  73.8, 45.6, 28.1)
// Cortes de los terciles (rango OR / rango medio de la sesión NY de los 20 días previos)
var CUTS = array.from(0.0848, 0.1303, 0.0957, 0.1481, 0.2332, 0.3378, 0.2650, 0.3830)
var SIZE_TXT = array.from("rango pequeño", "rango medio", "rango grande", "")
var STATE_TXT = array.from("", " · tras tocar el 50%", " · tras tocar el extremo opuesto")

// Probabilidad (%) de cada condición tras la ruptura. Índice = ((combo * 4 + tamaño) * 6 + condición)
//   condición: 0 vuelve al nivel roto · 1 toca el 50 % · 2 toca el extremo opuesto · 3 llega a 1.618
//              4 vuelve y continúa (llega a 1.272 antes del extremo opuesto) · 5 gira y continúa
var PEV = array.from(
     95.0, 80.6, 66.1, 83.3, 69.1, 23.6,  94.8, 74.2, 55.6, 77.7, 72.3, 20.1,  95.9, 68.0, 44.8, 64.0, 69.6, 19.3,  95.4, 73.4, 54.3, 74.8, 71.3, 20.3,
     94.6, 76.1, 61.3, 82.2, 68.3, 23.0,  94.0, 70.4, 48.6, 71.7, 71.6, 19.5,  95.1, 63.1, 38.5, 59.2, 67.3, 15.4,  94.5, 69.2, 48.3, 70.7, 69.7, 18.8,
     95.4, 77.4, 63.5, 84.5, 73.1, 20.1,  94.6, 73.3, 53.9, 78.5, 72.2, 20.3,  95.3, 65.5, 43.7, 68.9, 70.6, 17.8,  94.8, 71.8, 53.9, 77.0, 71.7, 19.3,
     96.2, 75.8, 59.6, 80.9, 75.7, 17.7,  94.7, 68.1, 47.8, 75.2, 73.3, 17.3,  94.1, 58.5, 35.5, 65.2, 70.4, 15.2,  94.6, 67.3, 47.8, 73.0, 72.3, 17.0)
// Probabilidad (%) de que la primera ruptura sea alcista según el contexto previo. Índice = sesión * 4 + contexto
//   contexto: 0 alza · 1 baja · 2 rango · 3 sin dato
var PUP = array.from(50.5, 53.9, 52.1, 52.1,  51.0, 51.7, 52.2, 51.7)
var PRE_TXT = array.from("al alza", "a la baja", "en rango", "sin dato")
var TER_TXT = array.from("pequeño", "medio", "grande", "sin dato")
var EV_TXT = array.from("Rompe al alza", "Vuelve al nivel roto", "Toca el 50 %", "Toca el extremo opuesto", "Llega a 1.618", "Vuelve y continúa", "Gira y continúa")

pev(int c, int ter, int ev) =>
    array.get(PEV, (c * 4 + ter) * 6 + ev)

prob(int c, int ter, int st) =>
    array.get(PROB, (c * 4 + ter) * 3 + st)

// --- Rango medio diario de la sesión de contado de NY (09:30-16:00), 20 días ------------------
nyCash = not na(time(timeframe.period, "0930-1600", "America/New_York"))
var float dH = na
var float dL = na
var array<float> rngs = array.new<float>()
if nyCash and not nyCash[1]
    dH := high
    dL := low
else if nyCash
    dH := na(dH) ? high : math.max(dH, high)
    dL := na(dL) ? low : math.min(dL, low)
if nyCash[1] and not nyCash and not na(dH)
    array.push(rngs, dH - dL)
    if array.size(rngs) > 20
        array.shift(rngs)
adr = array.size(rngs) >= 20 ? array.avg(rngs) : na

newLine(int x1, float y, color col, string sty, int w) =>
    line.new(x1, y, bar_index, y, color = col, style = sty, width = w)

// Una llamada por sesión: las variables 'var' de cada llamada son independientes.
orb(string sessOR, string sessHor, string sessPre, string tz, color col, string name, bool enabled, int combo, float adrNow) =>
    inOR  = enabled and not na(time(timeframe.period, sessOR, tz))
    inHor = enabled and not na(time(timeframe.period, sessHor, tz))
    inPre = enabled and not na(time(timeframe.period, sessPre, tz))
    // contexto previo a la apertura: (cierre − apertura) / (máx − mín) de la ventana previa
    var float preO = na
    var float preH = na
    var float preL = na
    var float preC = na
    if inPre and not inPre[1]
        preO := open
        preH := high
        preL := low
    else if inPre
        preH := na(preH) ? high : math.max(preH, high)
        preL := na(preL) ? low : math.min(preL, low)
    if inPre
        preC := close
    var float hi = na
    var float lo = na
    var int startBar = na
    var bool active = false
    var int dir = 0
    var bool retested = false
    var array<line> lines = array.new<line>()
    // proyección 1.618
    var int ter = 3
    var int brkBar = na
    var float tgt = na
    var int state = 0
    var bool hit = false
    var line projLine = na
    var label projLbl = na
    // registro de la apertura (backtesting)
    var int preT = 3
    var string brkTxt = ""
    var bool fV = false
    var bool f50 = false
    var bool fOpp = false
    var bool fExt = false
    var bool fCont = false
    var bool fGiro = false
    var bool oppFirst = false
    var int retBar = na
    var bool done = false
    var string scenTxt = ""
    var array<float> sumP = array.new<float>(7, 0.0)
    var array<float> hits = array.new<float>(7, 0.0)
    var int nDays = 0

    if inOR and not inOR[1]
        hi := high
        lo := low
        startBar := bar_index
        active := false
        dir := 0
        retested := false
        array.clear(lines)
        ter := 3
        brkBar := na
        tgt := na
        state := 0
        hit := false
        projLine := na
        projLbl := na
        eff = na(preO) or na(preH) or preH - preL <= 0 ? na : (preC - preO) / (preH - preL)
        preT := na(eff) ? 3 : eff >= 0.4 ? 0 : eff <= -0.4 ? 1 : 2
        preO := na
        preH := na
        preL := na
        brkTxt := ""
        fV := false
        f50 := false
        fOpp := false
        fExt := false
        fCont := false
        fGiro := false
        oppFirst := false
        retBar := na
        done := false
        scenTxt := ""
    else if inOR
        hi := na(hi) ? high : math.max(hi, high)
        lo := na(lo) ? low : math.min(lo, low)

    // Cierre del rango: primera vela fuera del OR dentro del horizonte
    if inOR[1] and not inOR and inHor and not na(hi) and not na(startBar)
        active := true
        r = hi - lo
        lightCol = color.new(col, 55)
        array.push(lines, newLine(startBar, hi, col, line.style_solid, 2))
        array.push(lines, newLine(startBar, lo, col, line.style_solid, 2))
        if showRet
            for k in RET
                array.push(lines, newLine(startBar, lo + r * k, k == 0.5 ? col : lightCol, line.style_dotted, 1))
        if showExt
            for e in EXT
                array.push(lines, newLine(startBar, hi + r * e, lightCol, line.style_dashed, 1))
                array.push(lines, newLine(startBar, lo - r * e, lightCol, line.style_dashed, 1))
        label.new(startBar, hi, name + " OR", style = label.style_label_lower_left, color = color.new(col, 85), textcolor = col, size = size.small)
        // tamaño del rango frente al rango medio diario -> tercil
        rel = na(adrNow) or adrNow <= 0 ? na : r / adrNow
        ter := na(rel) ? 3 : rel < array.get(CUTS, combo * 2) ? 0 : rel < array.get(CUTS, combo * 2 + 1) ? 1 : 2

    if active and inHor
        r = hi - lo
        mid = lo + 0.5 * r
        for l in lines
            l.set_x2(bar_index)
        // Ruptura: primer CIERRE fuera del rango
        if dir == 0 and close > hi
            dir := 1
            brkBar := bar_index
            tgt := hi + 0.618 * r
            brkTxt := "▲ " + str.format_time(time, "HH:mm", tz)
            if showMarks
                label.new(bar_index, high, "▲ ruptura " + name, style = label.style_label_down, color = col, textcolor = color.white, size = size.small)
        else if dir == 0 and close < lo
            dir := -1
            brkBar := bar_index
            tgt := lo - 0.618 * r
            brkTxt := "▼ " + str.format_time(time, "HH:mm", tz)
            if showMarks
                label.new(bar_index, low, "▼ ruptura " + name, style = label.style_label_up, color = col, textcolor = color.white, size = size.small)
        else if dir != 0 and not retested and ((dir == 1 and low <= hi) or (dir == -1 and high >= lo))
            retested := true
            if showMarks
                label.new(bar_index, dir == 1 ? hi : lo, "retest", style = label.style_label_left, color = color.new(col, 80), textcolor = col, size = size.tiny)

        // Registro: condiciones medidas desde la vela siguiente a la ruptura (x en unidades del rango)
        if dir != 0 and bar_index > brkBar
            fav = dir == 1 ? (high - hi) / r : (lo - low) / r
            adv = dir == 1 ? (low - hi) / r : (lo - high) / r
            if adv <= 0 and not fV
                fV := true
                retBar := bar_index
            if adv <= -0.5
                f50 := true
            if adv <= -1
                fOpp := true
            if fav >= 0.618
                fExt := true
            // escenario: tras volver, ¿llega antes a 1.272 a favor o al extremo opuesto? (empate -> extremo)
            if fV and not fCont and not oppFirst
                if adv <= -1
                    oppFirst := true
                else if fav >= 0.272 and bar_index > retBar
                    fCont := true
            if oppFirst and adv <= -1.272
                fGiro := true

        // Proyección 1.618: estado y probabilidad en vivo (desde la vela siguiente a la ruptura)
        if dir != 0 and showProj
            if bar_index > brkBar and not hit
                if (dir == 1 and high >= tgt) or (dir == -1 and low <= tgt)
                    hit := true
                else
                    if (dir == 1 and low <= lo) or (dir == -1 and high >= hi)
                        state := 2
                    else if state == 0 and ((dir == 1 and low <= mid) or (dir == -1 and high >= mid))
                        state := 1
            if na(projLine)
                projLine := line.new(brkBar, tgt, bar_index, tgt, color = colProj, style = line.style_solid, width = 2)
                projLbl := label.new(bar_index, tgt, "", style = label.style_label_left, color = color.new(colProj, 85), textcolor = colProj, size = size.small)
            projLine.set_x2(bar_index)
            projLbl.set_xy(bar_index, tgt)
            if hit
                projLbl.set_text("1.618 alcanzado ✓")
            else
                p = prob(combo, ter, state)
                sz = array.get(SIZE_TXT, ter)
                projLbl.set_text("Proyección 1.618: " + str.tostring(p, "#") + "%" + (sz == "" ? "" : " (" + sz + ")") + array.get(STATE_TXT, state))
    else if active and not inHor
        active := false
        if showProj and not na(projLbl) and not hit
            projLbl.set_text("1.618 no alcanzado")
            projLbl.set_textcolor(color.gray)
        // cierre de la sesión: resultado final y acumulado del gráfico
        if dir != 0
            done := true
            scenTxt := not fV ? "Continúa sin volver" : fCont ? "Vuelve y continúa" : oppFirst ? (fGiro ? "Gira y continúa" : "Rechazado en el otro extremo") : "Se queda en rango"
            flags = array.from(dir == 1, fV, f50, fOpp, fExt, fCont, fGiro)
            for i = 0 to 6
                pI = i == 0 ? array.get(PUP, (combo >= 2 ? 1 : 0) * 4 + preT) : pev(combo, ter, i - 1)
                array.set(sumP, i, array.get(sumP, i) + pI)
                array.set(hits, i, array.get(hits, i) + (array.get(flags, i) ? 1.0 : 0.0))
            nDays += 1
    [dir, preT, ter, brkTxt, array.from(dir == 1, fV, f50, fOpp, fExt, fCont, fGiro), done, scenTxt, sumP, hits, nDays]

cLon = orMin == 15 ? 0 : 1
cNy  = orMin == 15 ? 2 : 3
[dL0, preL0, terL0, brkL0, flgL0, doneL0, scL0, spL0, htL0, nL0] = orb(lonOR, lonHor, "0000-0800", "Europe/London", colLon, "Londres", showLon, cLon, adr)
[dN0, preN0, terN0, brkN0, flgN0, doneN0, scN0, spN0, htN0, nN0] = orb(nyOR, nyHor, "0400-0930", "America/New_York", colNy, "NY", showNy, cNy, adr)

// --- Tabla de registro (backtesting) -----------------------------------------------------------
// Texto de "hoy": probabilidad + ✓ si se cumplió, ✗ si la sesión terminó sin cumplirse, … si está en curso
cellHoy(float p, bool ok, bool known, bool fin) =>
    str.tostring(p, "#") + "% " + (ok ? "✓" : fin ? "✗" : known ? "…" : "")

cellGraf(array<float> sp, array<float> ht, int n, int i) =>
    n == 0 ? "—" : "pron. " + str.tostring(array.get(sp, i) / n, "#") + "% · real " + str.tostring(100 * array.get(ht, i) / n, "#") + "%"

regPosition = regPos == "Abajo derecha" ? position.bottom_right : regPos == "Arriba derecha" ? position.top_right : regPos == "Abajo izquierda" ? position.bottom_left : position.top_left

if showReg and barstate.islast
    var table reg = table.new(regPosition, 5, 12, bgcolor = color.new(color.gray, 88), border_width = 1)
    ts = size.small
    table.cell(reg, 0, 0, "Registro (OR " + str.tostring(orMin) + "m)", text_size = ts)
    table.cell(reg, 1, 0, "Londres hoy", text_size = ts, text_color = colLon)
    table.cell(reg, 2, 0, "NY hoy", text_size = ts, text_color = colNy)
    table.cell(reg, 3, 0, "Londres en el gráfico (n=" + str.tostring(nL0) + ")", text_size = ts, text_color = colLon)
    table.cell(reg, 4, 0, "NY en el gráfico (n=" + str.tostring(nN0) + ")", text_size = ts, text_color = colNy)
    // 1 · Apertura
    table.cell(reg, 0, 1, "1 · Antes de la apertura", text_size = ts)
    table.cell(reg, 1, 1, array.get(PRE_TXT, preL0), text_size = ts)
    table.cell(reg, 2, 1, array.get(PRE_TXT, preN0), text_size = ts)
    table.cell(reg, 3, 1, "", text_size = ts)
    table.cell(reg, 4, 1, "", text_size = ts)
    table.cell(reg, 0, 2, "   " + array.get(EV_TXT, 0), text_size = ts)
    table.cell(reg, 1, 2, cellHoy(array.get(PUP, preL0), dL0 == 1, dL0 != 0, dL0 == -1), text_size = ts)
    table.cell(reg, 2, 2, cellHoy(array.get(PUP, 4 + preN0), dN0 == 1, dN0 != 0, dN0 == -1), text_size = ts)
    table.cell(reg, 3, 2, cellGraf(spL0, htL0, nL0, 0), text_size = ts)
    table.cell(reg, 4, 2, cellGraf(spN0, htN0, nN0, 0), text_size = ts)
    // 2 · Rango
    table.cell(reg, 0, 3, "2 · Tamaño del rango", text_size = ts)
    table.cell(reg, 1, 3, array.get(TER_TXT, terL0), text_size = ts)
    table.cell(reg, 2, 3, array.get(TER_TXT, terN0), text_size = ts)
    table.cell(reg, 3, 3, "", text_size = ts)
    table.cell(reg, 4, 3, "", text_size = ts)
    // 3 · Ruptura
    table.cell(reg, 0, 4, "3 · Ruptura", text_size = ts)
    table.cell(reg, 1, 4, dL0 == 0 ? "esperando" : brkL0, text_size = ts)
    table.cell(reg, 2, 4, dN0 == 0 ? "esperando" : brkN0, text_size = ts)
    table.cell(reg, 3, 4, "", text_size = ts)
    table.cell(reg, 4, 4, "", text_size = ts)
    for i = 1 to 6
        table.cell(reg, 0, 4 + i, "   " + array.get(EV_TXT, i), text_size = ts)
        table.cell(reg, 1, 4 + i, dL0 == 0 ? "—" : cellHoy(pev(cLon, terL0, i - 1), array.get(flgL0, i), true, doneL0), text_size = ts)
        table.cell(reg, 2, 4 + i, dN0 == 0 ? "—" : cellHoy(pev(cNy, terN0, i - 1), array.get(flgN0, i), true, doneN0), text_size = ts)
        table.cell(reg, 3, 4 + i, cellGraf(spL0, htL0, nL0, i), text_size = ts)
        table.cell(reg, 4, 4 + i, cellGraf(spN0, htN0, nN0, i), text_size = ts)
    table.cell(reg, 0, 11, "Escenario", text_size = ts)
    table.cell(reg, 1, 11, doneL0 ? scL0 : dL0 == 0 ? "—" : "en curso", text_size = ts)
    table.cell(reg, 2, 11, doneN0 ? scN0 : dN0 == 0 ? "—" : "en curso", text_size = ts)
    table.cell(reg, 3, 11, "", text_size = ts)
    table.cell(reg, 4, 11, "", text_size = ts)

// Probabilidades medidas en el estudio (NAS100 + US500, 1 min, 2022-2026).
// Actualízalas con los valores de orb/results/dukascopy/REPORT.md si cambias datos o período.
if showStats and barstate.islast
    c0 = orMin == 15 ? 0 : 1
    c1 = orMin == 15 ? 2 : 3
    var table t = table.new(position.top_right, 3, 9, bgcolor = color.new(color.gray, 90), border_width = 1)
    table.cell(t, 0, 0, "Tras la ruptura (OR " + str.tostring(orMin) + "m)", text_size = size.small)
    table.cell(t, 1, 0, "Londres", text_size = size.small)
    table.cell(t, 2, 0, "NY", text_size = size.small)
    table.cell(t, 0, 1, "Retest del nivel roto", text_size = size.small)
    table.cell(t, 1, 1, orMin == 15 ? "95%" : "95%", text_size = size.small)
    table.cell(t, 2, 1, orMin == 15 ? "95%" : "95%", text_size = size.small)
    table.cell(t, 0, 2, "Retrocede al 50%", text_size = size.small)
    table.cell(t, 1, 2, orMin == 15 ? "73%" : "69%", text_size = size.small)
    table.cell(t, 2, 2, orMin == 15 ? "72%" : "67%", text_size = size.small)
    table.cell(t, 0, 3, "Toca el extremo opuesto", text_size = size.small)
    table.cell(t, 1, 3, orMin == 15 ? "54%" : "48%", text_size = size.small)
    table.cell(t, 2, 3, orMin == 15 ? "54%" : "48%", text_size = size.small)
    table.cell(t, 0, 4, "Llega a 1.618", text_size = size.small)
    table.cell(t, 1, 4, str.tostring(prob(c0, 3, 0), "#") + "%", text_size = size.small)
    table.cell(t, 2, 4, str.tostring(prob(c1, 3, 0), "#") + "%", text_size = size.small)
    table.cell(t, 0, 5, "  con rango pequeño / grande", text_size = size.small)
    table.cell(t, 1, 5, str.tostring(prob(c0, 0, 0), "#") + "% / " + str.tostring(prob(c0, 2, 0), "#") + "%", text_size = size.small)
    table.cell(t, 2, 5, str.tostring(prob(c1, 0, 0), "#") + "% / " + str.tostring(prob(c1, 2, 0), "#") + "%", text_size = size.small)
    table.cell(t, 0, 6, "  si ya tocó el 50%", text_size = size.small)
    table.cell(t, 1, 6, str.tostring(prob(c0, 3, 1), "#") + "%", text_size = size.small)
    table.cell(t, 2, 6, str.tostring(prob(c1, 3, 1), "#") + "%", text_size = size.small)
    table.cell(t, 0, 7, "  si ya tocó el extremo opuesto", text_size = size.small)
    table.cell(t, 1, 7, str.tostring(prob(c0, 3, 2), "#") + "%", text_size = size.small)
    table.cell(t, 2, 7, str.tostring(prob(c1, 3, 2), "#") + "%", text_size = size.small)
    table.cell(t, 0, 8, "1.618 antes que 50%", text_size = size.small)
    table.cell(t, 1, 8, orMin == 15 ? "53%" : "52%", text_size = size.small)
    table.cell(t, 2, 8, orMin == 15 ? "53%" : "53%", text_size = size.small)
