// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0
// ORB Londres / Nueva York + Fibonacci + proyección 1.618
// Dibuja el rango de apertura (15 o 20 min) de Londres y Nueva York, los retrocesos Fibonacci
// dentro del rango y las extensiones fuera de él, y marca la primera ruptura por cierre y el
// primer retest del nivel roto. Tras la ruptura proyecta la extensión 1.618 en la dirección de la
// ruptura con la probabilidad de alcanzarla, que se actualiza en vivo según el tamaño del rango y
// lo que haga el precio (si retrocede al 50 % o toca el extremo opuesto antes de llegar).
// Al tocar 1.618 proyecta la extensión 2.0 con su probabilidad, que baja si el precio vuelve a
// 1.272 o al nivel roto antes de llegar.
// Tabla de registro (backtesting): para la última apertura de cada bolsa muestra, por etapas
// (apertura -> cierre del rango -> ruptura), la probabilidad histórica de cada condición y si se
// cumplió (✓ / ✗). Las columnas "en el gráfico" suman todas las aperturas cargadas en el gráfico:
// probabilidad media pronosticada frente a frecuencia real.
// Probabilidades medidas en el estudio en Python (orb/), NAS100 + US500, 1 min, 2022-2026.
// El dashboard (tablas) se muestra u oculta con "Mostrar el dashboard" en los ajustes.
// Bias del día: vela del día de 00:00 a 23:59 (en cada apertura, precio frente a la apertura de las
// 00:00; al cerrar el día se marca si terminó del mismo color) o la ventana previa a la apertura.
// Úsalo en gráficos de 1 a 5 minutos.
//@version=6
indicator("ORB Londres/NY + Fibonacci", overlay = true, max_lines_count = 500, max_labels_count = 500)

orMin = input.int(15, "Minutos del rango de apertura", options = [15, 20])

grpL = "Londres"
showLon = input.bool(true, "Mostrar Londres", group = grpL)
lonHor  = input.session("0800-1200", "Horizonte (hasta cuándo se siguen los niveles)", group = grpL)
colLon  = input.color(#2a78d6, "Color", group = grpL)

grpN = "Nueva York"
showNy = input.bool(true, "Mostrar Nueva York", group = grpN)
nyHor  = input.session("0930-1600", "Horizonte (hasta cuándo se siguen los niveles)", group = grpN)
colNy  = input.color(#eb6834, "Color", group = grpN)

grpF = "Fibonacci"
showRet   = input.bool(true, "Retrocesos dentro del rango (23.6 / 38.2 / 50 / 61.8 / 78.6)", group = grpF)
showRetLb = input.bool(true, "Etiquetas de los niveles dentro del rango", group = grpF, tooltip = "Antes de la ruptura se miden desde el mínimo del rango. Tras la ruptura se miden desde el nivel roto (0 = nivel roto, 1 = extremo opuesto), igual que en el estudio: con ruptura alcista los niveles se recolocan desde el máximo.")
col05     = input.color(#e91e63, "Color del 0,5 (mitad del rango)", group = grpF)
width05   = input.int(2, "Grosor del 0,5", minval = 1, maxval = 4, group = grpF)
colRet    = input.color(color.new(color.gray, 20), "Color de los demás retrocesos", group = grpF)
showExt   = input.bool(true, "Extensiones fuera del rango (1.272 / 1.618 / 2.0 / 2.618)", group = grpF)
showMarks = input.bool(true, "Marcar ruptura y retest", group = grpF)
showProj  = input.bool(true, "Proyección 1.618 con probabilidad", group = grpF)
colProj   = input.color(#1baf7a, "Color de la proyección", group = grpF)
showProj2 = input.bool(true, "Proyección 2.0 al tocar 1.618", group = grpF)
colProj2  = input.color(#6250d6, "Color de la proyección 2.0", group = grpF)

grpB = "Bias"
biasSrc  = input.string("Vela del día (desde las 00:00)", "Bias del día", options = ["Vela del día (desde las 00:00)", "Ventana previa a la apertura"], group = grpB, tooltip = "Vela del día: la vela de 00:00 a 23:59. En cada apertura el bias es alcista si el precio está por encima de la apertura de las 00:00 y bajista si está por debajo (neutral si está muy cerca). Al cerrar el día se marca si la vela terminó del mismo color. Ventana previa: tendencia de 00:00-08:00 (Londres) o 04:00-09:30 (NY).")
tzBias   = input.string("America/New_York", "Zona horaria de la vela del día", options = ["America/New_York", "UTC", "Europe/London", "Europe/Madrid", "America/Mexico_City", "America/Bogota", "America/Argentina/Buenos_Aires"], group = grpB, tooltip = "Las probabilidades se midieron con el día de Nueva York y con UTC; con otras zonas se muestran las de Nueva York.")
dojiPct  = input.float(10, "Distancia mínima para no ser neutral (% del rango del día hasta ese momento)", minval = 0, maxval = 50, step = 1, group = grpB)
useDailyBias = biasSrc == "Vela del día (desde las 00:00)"
tzIdx = tzBias == "UTC" ? 1 : 0

grpD = "Dashboard (tablas en el gráfico)"
showDash  = input.bool(true, "Mostrar el dashboard", group = grpD, tooltip = "Interruptor general: desmárcalo para ocultar todas las tablas y dejar solo los niveles en el gráfico.")
showReg   = input.bool(true, "Tabla de registro por apertura (backtesting)", group = grpD)
regPos    = input.string("Abajo derecha", "Posición del registro", options = ["Abajo derecha", "Arriba derecha", "Abajo izquierda", "Arriba izquierda"], group = grpD)
showStats = input.bool(false, "Tabla de probabilidades del estudio", group = grpD)
statsPos  = input.string("Arriba derecha", "Posición de la tabla de probabilidades", options = ["Arriba derecha", "Abajo derecha", "Arriba izquierda", "Abajo izquierda"], group = grpD)
dashSize  = input.string("Pequeño", "Tamaño del texto", options = ["Diminuto", "Pequeño", "Normal"], group = grpD)
dashTs    = dashSize == "Diminuto" ? size.tiny : dashSize == "Normal" ? size.normal : size.small

posOf(string p) =>
    p == "Abajo derecha" ? position.bottom_right : p == "Arriba derecha" ? position.top_right : p == "Abajo izquierda" ? position.bottom_left : position.top_left

lonOR = orMin == 15 ? "0800-0815" : "0800-0820"
nyOR  = orMin == 15 ? "0930-0945" : "0930-0950"

var RET = array.from(0.236, 0.382, 0.5, 0.618, 0.786)
var EXT = array.from(0.272, 0.618, 1.0, 1.618)

// --- Probabilidad (%) de alcanzar la extensión 1.618 tras la ruptura -------------------------
// Índice = (combo * 4 + tamaño) * 3 + estado
//   combo:  0 Londres OR15 · 1 Londres OR20 · 2 NY OR15 · 3 NY OR20
//   tamaño: 0 rango pequeño · 1 medio · 2 grande (terciles de rango OR / rango medio diario NY) · 3 sin dato
//   estado: 0 recién roto · 1 ya retrocedió al 50 % sin llegar · 2 ya tocó el extremo opuesto sin llegar
var PROB = array.from(
     83.2, 61.4, 46.1,  77.8, 53.8, 34.7,  64.0, 32.0, 14.3,  75.0, 48.5, 31.5,
     82.2, 59.3, 43.6,  71.9, 43.5, 25.2,  59.0, 24.9, 12.7,  71.0, 42.1, 27.5,
     84.5, 67.4, 52.8,  78.5, 52.9, 32.1,  68.9, 36.2, 21.1,  77.3, 52.2, 35.7,
     80.9, 61.3, 43.0,  75.2, 45.6, 22.9,  65.2, 27.5, 14.9,  73.8, 45.6, 28.1)
// Cortes de los terciles (rango OR / rango medio de la sesión NY de los 20 días previos)
var CUTS = array.from(0.0848, 0.1303, 0.0957, 0.1481, 0.2332, 0.3378, 0.2650, 0.3830)
// Probabilidad (%) de llegar a 2.0 una vez tocado 1.618. Índice = (combo * 4 + tamaño) * 3 + estado
//   estado: 0 recién tocado 1.618 · 1 ya volvió a 1.272 sin llegar · 2 ya volvió al nivel roto sin llegar
var PROB2 = array.from(
     86.3, 71.8, 61.6,  81.5, 61.9, 48.4,  70.7, 47.2, 36.2,  80.0, 60.5, 48.2,
     82.8, 65.5, 54.8,  78.6, 59.1, 44.3,  64.3, 37.0, 25.2,  76.0, 54.8, 41.7,
     86.3, 73.2, 64.9,  81.2, 64.8, 53.2,  74.3, 51.3, 35.1,  80.6, 63.3, 52.5,
     83.6, 69.0, 57.0,  77.5, 55.4, 43.4,  70.7, 47.0, 33.6,  77.4, 57.4, 45.4)
var STATE2_TXT = array.from("", " · tras volver a 1.272", " · tras volver al nivel roto")
var SIZE_TXT = array.from("rango pequeño", "rango medio", "rango grande", "")
var STATE_TXT = array.from("", " · tras tocar el 50%", " · tras tocar el extremo opuesto")

// Probabilidad (%) de cada condición tras la ruptura. Índice = ((combo * 4 + tamaño) * 6 + condición)
//   condición: 0 vuelve al nivel roto · 1 toca el 50 % · 2 toca el extremo opuesto · 3 llega a 1.618
//              4 vuelve y continúa (llega a 1.272 antes del extremo opuesto) · 5 gira y continúa
var PEV = array.from(
     95.0, 80.6, 66.1, 83.3, 69.1, 23.6,  94.8, 74.2, 55.6, 77.7, 72.3, 20.1,  95.9, 68.0, 44.8, 64.0, 69.6, 19.3,  95.4, 73.4, 54.3, 74.8, 71.3, 20.3,
     94.6, 76.1, 61.3, 82.2, 68.3, 23.0,  94.0, 70.4, 48.6, 71.7, 71.6, 19.5,  95.1, 63.1, 38.5, 59.2, 67.3, 15.4,  94.5, 69.2, 48.3, 70.7, 69.7, 18.8,
     95.4, 77.4, 63.5, 84.5, 73.1, 20.1,  94.6, 73.3, 53.9, 78.5, 72.2, 20.3,  95.3, 65.5, 43.7, 68.9, 70.6, 17.8,  94.8, 71.8, 53.9, 77.0, 71.7, 19.3,
     96.2, 75.8, 59.6, 80.9, 75.7, 17.7,  94.7, 68.1, 47.8, 75.2, 73.3, 17.3,  94.1, 58.5, 35.5, 65.2, 70.4, 15.2,  94.6, 67.3, 47.8, 73.0, 72.3, 17.0)
// Probabilidad (%) de que la primera ruptura sea alcista según el contexto previo. Índice = sesión * 4 + contexto
//   contexto: 0 alza · 1 baja · 2 rango · 3 sin dato
var PUP = array.from(50.5, 53.9, 52.1, 52.1,  51.0, 51.7, 52.2, 51.7)
// Igual, según la vela del día en curso en la apertura (precio frente a la apertura de las 00:00).
// Índice = tz * 16 + combo * 4 + bias   (tz: 0 Nueva York · 1 UTC; bias: 0 alcista · 1 bajista · 2 neutral · 3 sin dato)
var PUPD = array.from(
     49.9, 54.0, 53.1, 52.0,   51.2, 56.2, 53.1, 53.4,   51.8, 51.6, 51.5, 51.6,   50.8, 52.6, 51.3, 51.6,
     50.1, 53.1, 56.6, 52.0,   50.9, 55.0, 59.8, 53.4,   51.3, 50.6, 58.6, 51.6,   50.9, 52.1, 53.5, 51.6)
// Probabilidad (%) de que la vela del día termine del color del bias que tenía en la apertura.
// Índice = tz * 8 + combo * 2 + (0 alcista · 1 bajista)
var PDAY = array.from(
     60.2, 54.8,  60.2, 54.8,  71.9, 68.8,  71.9, 68.7,
     63.4, 57.9,  63.4, 57.8,  71.0, 67.7,  71.0, 67.6)
var BIAS_TXT = array.from("alcista", "bajista", "neutral", "sin dato")
var PRE_TXT = array.from("al alza", "a la baja", "en rango", "sin dato")
var TER_TXT = array.from("pequeño", "medio", "grande", "sin dato")
var EV_TXT = array.from("Rompe a favor del bias", "Vuelve al nivel roto", "Toca el 50 %", "Toca el extremo opuesto", "Llega a 1.618", "Vuelve y continúa", "Gira y continúa")

// Probabilidad de que la primera ruptura vaya a favor del bias (alcista -> al alza, bajista -> a la baja;
// neutral o sin dato -> al alza)
pUp(int c, int b) =>
    useDailyBias ? array.get(PUPD, tzIdx * 16 + c * 4 + b) : array.get(PUP, (c >= 2 ? 1 : 0) * 4 + b)

pDay(int c, int b) =>
    b <= 1 ? array.get(PDAY, tzIdx * 8 + c * 2 + b) : na

pFavor(int c, int b) =>
    b == 1 ? 100 - pUp(c, b) : pUp(c, b)

biasTxt(int b) =>
    useDailyBias ? array.get(BIAS_TXT, b) : array.get(PRE_TXT, b)

pev(int c, int ter, int ev) =>
    array.get(PEV, (c * 4 + ter) * 6 + ev)

prob(int c, int ter, int st) =>
    array.get(PROB, (c * 4 + ter) * 3 + st)

prob2(int c, int ter, int st) =>
    array.get(PROB2, (c * 4 + ter) * 3 + st)

// --- Rango medio diario de la sesión de contado de NY (09:30-16:00), 20 días ------------------
nyCash = not na(time(timeframe.period, "0930-1600", "America/New_York"))
var float dH = na
var float dL = na
var array<float> rngs = array.new<float>()
if nyCash and not nyCash[1]
    dH := high
    dL := low
else if nyCash
    dH := na(dH) ? high : math.max(dH, high)
    dL := na(dL) ? low : math.min(dL, low)
if nyCash[1] and not nyCash and not na(dH)
    array.push(rngs, dH - dL)
    if array.size(rngs) > 20
        array.shift(rngs)
adr = array.size(rngs) >= 20 ? array.avg(rngs) : na

// --- Vela del día (00:00-23:59 en la zona elegida) ------------------------------------------------
dNum = dayofmonth(time, tzBias)
newDayB = dNum != dNum[1]
var float dOpen = na
var float dHi = na
var float dLo = na
var float endedOpen = na
var float endedClose = na
if newDayB
    endedOpen := dOpen
    endedClose := close[1]
    dOpen := open
    dHi := high
    dLo := low
else
    dHi := na(dHi) ? high : math.max(dHi, high)
    dLo := na(dLo) ? low : math.min(dLo, low)
dayEnded = newDayB and not na(endedOpen)
endedGreen = endedClose > endedOpen
// bias en este momento: precio (cierre de la vela anterior) frente a la apertura de las 00:00
biasD = na(dOpen) or newDayB ? 3 : math.abs(close[1] - dOpen) < dojiPct / 100 * (dHi - dLo) ? 2 : close[1] > dOpen ? 0 : 1
dayPct = na(dOpen) ? na : 100 * (close - dOpen) / dOpen

newLine(int x1, float y, color col, string sty, int w) =>
    line.new(x1, y, bar_index, y, color = col, style = sty, width = w)

// Una llamada por sesión: las variables 'var' de cada llamada son independientes.
orb(string sessOR, string sessHor, string sessPre, string tz, color col, string name, bool enabled, int combo, float adrNow, int biasNow, bool dEnd, bool dGreen) =>
    inOR  = enabled and not na(time(timeframe.period, sessOR, tz))
    inHor = enabled and not na(time(timeframe.period, sessHor, tz))
    inPre = enabled and not na(time(timeframe.period, sessPre, tz))
    // contexto previo a la apertura: (cierre − apertura) / (máx − mín) de la ventana previa
    var float preO = na
    var float preH = na
    var float preL = na
    var float preC = na
    if inPre and not inPre[1]
        preO := open
        preH := high
        preL := low
    else if inPre
        preH := na(preH) ? high : math.max(preH, high)
        preL := na(preL) ? low : math.min(preL, low)
    if inPre
        preC := close
    var float hi = na
    var float lo = na
    var int startBar = na
    var bool active = false
    var int dir = 0
    var bool retested = false
    var array<line> lines = array.new<line>()
    var array<label> fibLbls = array.new<label>()
    var array<line> retLines = array.new<line>()
    // proyección 1.618
    var int ter = 3
    var int brkBar = na
    var float tgt = na
    var int state = 0
    var bool hit = false
    var line projLine = na
    var label projLbl = na
    // registro de la apertura (backtesting)
    var int preT = 3
    var string brkTxt = ""
    var bool fV = false
    var bool f50 = false
    var bool fOpp = false
    var bool fExt = false
    var bool fCont = false
    var bool fGiro = false
    var bool oppFirst = false
    var int retBar = na
    var bool done = false
    var string scenTxt = ""
    var array<float> sumP = array.new<float>(7, 0.0)
    var array<float> hits = array.new<float>(7, 0.0)
    var int nDays = 0
    // de 1.618 a 2.0
    var int bar1618 = na
    var bool hit2 = false
    var int st2 = 0
    var float p2at = na
    var line proj2Line = na
    var label proj2Lbl = na
    var float sum2 = 0.0
    var float hits2 = 0.0
    var int n2 = 0
    // vela del día: ¿termina del color del bias que tenía en la apertura?
    var bool waitDay = false
    var bool dayDone = false
    var bool dayHit = false
    var float sumD = 0.0
    var float hitsD = 0.0
    var int nD = 0
    if dEnd and waitDay
        dayHit := (preT == 0 and dGreen) or (preT == 1 and not dGreen)
        sumD += pDay(combo, preT)
        hitsD += dayHit ? 1.0 : 0.0
        nD += 1
        waitDay := false
        dayDone := true

    if inOR and not inOR[1]
        hi := high
        lo := low
        startBar := bar_index
        active := false
        dir := 0
        retested := false
        array.clear(lines)
        array.clear(fibLbls)
        array.clear(retLines)
        ter := 3
        brkBar := na
        tgt := na
        state := 0
        hit := false
        projLine := na
        projLbl := na
        eff = na(preO) or na(preH) or preH - preL <= 0 ? na : (preC - preO) / (preH - preL)
        preT := useDailyBias ? biasNow : na(eff) ? 3 : eff >= 0.4 ? 0 : eff <= -0.4 ? 1 : 2
        waitDay := useDailyBias and preT <= 1
        dayDone := false
        dayHit := false
        preO := na
        preH := na
        preL := na
        brkTxt := ""
        fV := false
        f50 := false
        fOpp := false
        fExt := false
        fCont := false
        fGiro := false
        oppFirst := false
        retBar := na
        done := false
        scenTxt := ""
        bar1618 := na
        hit2 := false
        st2 := 0
        p2at := na
        proj2Line := na
        proj2Lbl := na
    else if inOR
        hi := na(hi) ? high : math.max(hi, high)
        lo := na(lo) ? low : math.min(lo, low)

    // Cierre del rango: primera vela fuera del OR dentro del horizonte
    if inOR[1] and not inOR and inHor and not na(hi) and not na(startBar)
        active := true
        r = hi - lo
        lightCol = color.new(col, 55)
        array.push(lines, newLine(startBar, hi, col, line.style_solid, 2))
        array.push(lines, newLine(startBar, lo, col, line.style_solid, 2))
        if showRet
            for k in RET
                is05 = k == 0.5
                ln = newLine(startBar, lo + r * k, is05 ? col05 : colRet, is05 ? line.style_solid : line.style_dotted, is05 ? width05 : 1)
                array.push(lines, ln)
                array.push(retLines, ln)
                if showRetLb
                    array.push(fibLbls, label.new(bar_index, lo + r * k, (is05 ? "0.5  (50 %)" : str.tostring(k)), style = label.style_label_left, color = color.new(color.white, 100), textcolor = is05 ? col05 : colRet, size = is05 ? size.normal : size.small))
        if showExt
            for e in EXT
                array.push(lines, newLine(startBar, hi + r * e, lightCol, line.style_dashed, 1))
                array.push(lines, newLine(startBar, lo - r * e, lightCol, line.style_dashed, 1))
        label.new(startBar, hi, name + " OR", style = label.style_label_lower_left, color = color.new(col, 85), textcolor = col, size = size.small)
        // tamaño del rango frente al rango medio diario -> tercil
        rel = na(adrNow) or adrNow <= 0 ? na : r / adrNow
        ter := na(rel) ? 3 : rel < array.get(CUTS, combo * 2) ? 0 : rel < array.get(CUTS, combo * 2 + 1) ? 1 : 2

    if active and inHor
        r = hi - lo
        mid = lo + 0.5 * r
        for l in lines
            l.set_x2(bar_index)
        // etiquetas Fibonacci internas: siguen al final de la línea
        for lb in fibLbls
            lb.set_x(bar_index)
        // Ruptura: primer CIERRE fuera del rango
        if dir == 0 and close > hi
            dir := 1
            brkBar := bar_index
            tgt := hi + 0.618 * r
            // ruptura alcista: los retrocesos se miden desde el máximo (nivel roto) hacia abajo
            for [i, ln] in retLines
                y = hi - array.get(RET, i) * r
                ln.set_y1(y)
                ln.set_y2(y)
                if i < array.size(fibLbls)
                    array.get(fibLbls, i).set_y(y)
            brkTxt := "▲ " + str.format_time(time, "HH:mm", tz)
            if showMarks
                label.new(bar_index, high, "▲ ruptura " + name, style = label.style_label_down, color = col, textcolor = color.white, size = size.small)
        else if dir == 0 and close < lo
            dir := -1
            brkBar := bar_index
            tgt := lo - 0.618 * r
            brkTxt := "▼ " + str.format_time(time, "HH:mm", tz)
            if showMarks
                label.new(bar_index, low, "▼ ruptura " + name, style = label.style_label_up, color = col, textcolor = color.white, size = size.small)
        else if dir != 0 and not retested and ((dir == 1 and low <= hi) or (dir == -1 and high >= lo))
            retested := true
            if showMarks
                label.new(bar_index, dir == 1 ? hi : lo, "retest", style = label.style_label_left, color = color.new(col, 80), textcolor = col, size = size.tiny)

        // Registro: condiciones medidas desde la vela siguiente a la ruptura (x en unidades del rango)
        if dir != 0 and bar_index > brkBar
            fav = dir == 1 ? (high - hi) / r : (lo - low) / r
            adv = dir == 1 ? (low - hi) / r : (lo - high) / r
            if adv <= 0 and not fV
                fV := true
                retBar := bar_index
            if adv <= -0.5
                f50 := true
            if adv <= -1
                fOpp := true
            if fav >= 0.618
                fExt := true
            // escenario: tras volver, ¿llega antes a 1.272 a favor o al extremo opuesto? (empate -> extremo)
            if fV and not fCont and not oppFirst
                if adv <= -1
                    oppFirst := true
                else if fav >= 0.272 and bar_index > retBar
                    fCont := true
            if oppFirst and adv <= -1.272
                fGiro := true
            // de 1.618 a 2.0: estado medido desde la vela siguiente a la que toca 1.618
            if fExt and na(bar1618)
                bar1618 := bar_index
                p2at := prob2(combo, ter, 0)
            if not na(bar1618) and not hit2
                if fav >= 1.0
                    hit2 := true
                else if bar_index > bar1618
                    if adv <= 0
                        st2 := 2
                    else if st2 == 0 and adv <= 0.272
                        st2 := 1
            if showProj2 and not na(bar1618)
                tgt2 = dir == 1 ? hi + r : lo - r
                if na(proj2Line)
                    proj2Line := line.new(bar1618, tgt2, bar_index, tgt2, color = colProj2, style = line.style_solid, width = 2)
                    proj2Lbl := label.new(bar_index, tgt2, "", style = label.style_label_left, color = color.new(colProj2, 85), textcolor = colProj2, size = size.small)
                proj2Line.set_x2(bar_index)
                proj2Lbl.set_xy(bar_index, tgt2)
                proj2Lbl.set_text(hit2 ? "2.0 alcanzado ✓" : "Proyección 2.0: " + str.tostring(prob2(combo, ter, st2), "#") + "%" + array.get(STATE2_TXT, st2))

        // Proyección 1.618: estado y probabilidad en vivo (desde la vela siguiente a la ruptura)
        if dir != 0 and showProj
            if bar_index > brkBar and not hit
                if (dir == 1 and high >= tgt) or (dir == -1 and low <= tgt)
                    hit := true
                else
                    if (dir == 1 and low <= lo) or (dir == -1 and high >= hi)
                        state := 2
                    else if state == 0 and ((dir == 1 and low <= mid) or (dir == -1 and high >= mid))
                        state := 1
            if na(projLine)
                projLine := line.new(brkBar, tgt, bar_index, tgt, color = colProj, style = line.style_solid, width = 2)
                projLbl := label.new(bar_index, tgt, "", style = label.style_label_left, color = color.new(colProj, 85), textcolor = colProj, size = size.small)
            projLine.set_x2(bar_index)
            projLbl.set_xy(bar_index, tgt)
            if hit
                projLbl.set_text("1.618 alcanzado ✓")
            else
                p = prob(combo, ter, state)
                sz = array.get(SIZE_TXT, ter)
                projLbl.set_text("Proyección 1.618: " + str.tostring(p, "#") + "%" + (sz == "" ? "" : " (" + sz + ")") + array.get(STATE_TXT, state))
    else if active and not inHor
        active := false
        if showProj and not na(projLbl) and not hit
            projLbl.set_text("1.618 no alcanzado")
            projLbl.set_textcolor(color.gray)
        if showProj2 and not na(proj2Lbl) and not hit2
            proj2Lbl.set_text("2.0 no alcanzado")
            proj2Lbl.set_textcolor(color.gray)
        // cierre de la sesión: resultado final y acumulado del gráfico
        if dir != 0
            done := true
            scenTxt := not fV ? "Continúa sin volver" : fCont ? "Vuelve y continúa" : oppFirst ? (fGiro ? "Gira y continúa" : "Rechazado en el otro extremo") : "Se queda en rango"
            flags = array.from(preT == 1 ? dir == -1 : dir == 1, fV, f50, fOpp, fExt, fCont, fGiro)
            for i = 0 to 6
                pI = i == 0 ? pFavor(combo, preT) : pev(combo, ter, i - 1)
                array.set(sumP, i, array.get(sumP, i) + pI)
                array.set(hits, i, array.get(hits, i) + (array.get(flags, i) ? 1.0 : 0.0))
            nDays += 1
            if not na(bar1618)
                sum2 += p2at
                hits2 += hit2 ? 1.0 : 0.0
                n2 += 1
    [dir, preT, ter, brkTxt, array.from(preT == 1 ? dir == -1 : dir == 1, fV, f50, fOpp, fExt, fCont, fGiro), done, scenTxt, sumP, hits, nDays, st2, hit2, sum2, hits2, n2, dayDone, dayHit, sumD, hitsD, nD]

cLon = orMin == 15 ? 0 : 1
cNy  = orMin == 15 ? 2 : 3
[dL0, preL0, terL0, brkL0, flgL0, doneL0, scL0, spL0, htL0, nL0, st2L, hit2L, s2L, h2L, n2L, ddL, dhL, sdL, hdL, ndL] = orb(lonOR, lonHor, "0000-0800", "Europe/London", colLon, "Londres", showLon, cLon, adr, biasD, dayEnded, endedGreen)
[dN0, preN0, terN0, brkN0, flgN0, doneN0, scN0, spN0, htN0, nN0, st2N, hit2N, s2N, h2N, n2N, ddN, dhN, sdN, hdN, ndN] = orb(nyOR, nyHor, "0400-0930", "America/New_York", colNy, "NY", showNy, cNy, adr, biasD, dayEnded, endedGreen)

// --- Tabla de registro (backtesting) -----------------------------------------------------------
// Texto de "hoy": probabilidad + ✓ si se cumplió, ✗ si la sesión terminó sin cumplirse, … si está en curso
cellHoy(float p, bool ok, bool known, bool fin) =>
    str.tostring(p, "#") + "% " + (ok ? "✓" : fin ? "✗" : known ? "…" : "")

cellGraf(array<float> sp, array<float> ht, int n, int i) =>
    n == 0 ? "—" : "pron. " + str.tostring(array.get(sp, i) / n, "#") + "% · real " + str.tostring(100 * array.get(ht, i) / n, "#") + "%"

cell2Hoy(int c, int ter, bool hit1618, int st, bool ok, bool fin) =>
    not hit1618 ? (fin ? "no tocó 1.618" : "—") : str.tostring(prob2(c, ter, st), "#") + "% " + (ok ? "✓" : fin ? "✗" : "…")

cell2Graf(float s2, float h2, int n) =>
    n == 0 ? "—" : "pron. " + str.tostring(s2 / n, "#") + "% · real " + str.tostring(100 * h2 / n, "#") + "% (n=" + str.tostring(n) + ")"


biasCol(int b) =>
    b == 0 ? color.teal : b == 1 ? color.red : color.gray

cellDay(int c, int b, bool ddone, bool dhit) =>
    b > 1 ? "—" : str.tostring(pDay(c, b), "#") + "% " + (ddone ? (dhit ? "✓" : "✗") : "…")

cellDayGraf(float sd, float hd, int n) =>
    n == 0 ? "—" : "pron. " + str.tostring(sd / n, "#") + "% · real " + str.tostring(100 * hd / n, "#") + "% (n=" + str.tostring(n) + ")"

if showDash and showReg and barstate.islast
    var table reg = table.new(posOf(regPos), 5, 15, bgcolor = color.new(color.gray, 88), border_width = 1)
    ts = dashTs
    table.cell(reg, 0, 0, "Registro (OR " + str.tostring(orMin) + "m)", text_size = ts)
    table.cell(reg, 1, 0, "Londres hoy", text_size = ts, text_color = colLon)
    table.cell(reg, 2, 0, "NY hoy", text_size = ts, text_color = colNy)
    table.cell(reg, 3, 0, "Londres en el gráfico (n=" + str.tostring(nL0) + ")", text_size = ts, text_color = colLon)
    table.cell(reg, 4, 0, "NY en el gráfico (n=" + str.tostring(nN0) + ")", text_size = ts, text_color = colNy)
    // 0 · Vela del día ahora
    if useDailyBias
        table.cell(reg, 0, 1, "Vela del día ahora (desde 00:00)", text_size = ts)
        dayTxt = na(dayPct) ? "—" : (dayPct >= 0 ? "verde +" : "roja ") + str.tostring(dayPct, "#.##") + " %"
        dayCol = na(dayPct) ? color.gray : dayPct >= 0 ? color.teal : color.red
        table.cell(reg, 1, 1, dayTxt, text_size = ts, text_color = dayCol)
        table.cell(reg, 2, 1, dayTxt, text_size = ts, text_color = dayCol)
    else
        table.cell(reg, 0, 1, "", text_size = ts)
        table.cell(reg, 1, 1, "", text_size = ts)
        table.cell(reg, 2, 1, "", text_size = ts)
    table.cell(reg, 3, 1, "", text_size = ts)
    table.cell(reg, 4, 1, "", text_size = ts)
    // 1 · Bias en la apertura
    table.cell(reg, 0, 2, useDailyBias ? "1 · Bias en la apertura (vela del día)" : "1 · Antes de la apertura", text_size = ts)
    table.cell(reg, 1, 2, biasTxt(preL0), text_size = ts, text_color = biasCol(preL0))
    table.cell(reg, 2, 2, biasTxt(preN0), text_size = ts, text_color = biasCol(preN0))
    table.cell(reg, 3, 2, "", text_size = ts)
    table.cell(reg, 4, 2, "", text_size = ts)
    table.cell(reg, 0, 3, "   El día termina del color del bias", text_size = ts)
    table.cell(reg, 1, 3, useDailyBias ? cellDay(cLon, preL0, ddL, dhL) : "—", text_size = ts)
    table.cell(reg, 2, 3, useDailyBias ? cellDay(cNy, preN0, ddN, dhN) : "—", text_size = ts)
    table.cell(reg, 3, 3, useDailyBias ? cellDayGraf(sdL, hdL, ndL) : "—", text_size = ts)
    table.cell(reg, 4, 3, useDailyBias ? cellDayGraf(sdN, hdN, ndN) : "—", text_size = ts)
    table.cell(reg, 0, 4, "   " + array.get(EV_TXT, 0), text_size = ts)
    table.cell(reg, 1, 4, cellHoy(pFavor(cLon, preL0), array.get(flgL0, 0) and dL0 != 0, dL0 != 0, dL0 != 0 and not array.get(flgL0, 0)), text_size = ts)
    table.cell(reg, 2, 4, cellHoy(pFavor(cNy, preN0), array.get(flgN0, 0) and dN0 != 0, dN0 != 0, dN0 != 0 and not array.get(flgN0, 0)), text_size = ts)
    table.cell(reg, 3, 4, cellGraf(spL0, htL0, nL0, 0), text_size = ts)
    table.cell(reg, 4, 4, cellGraf(spN0, htN0, nN0, 0), text_size = ts)
    // 2 · Rango
    table.cell(reg, 0, 5, "2 · Tamaño del rango", text_size = ts)
    table.cell(reg, 1, 5, array.get(TER_TXT, terL0), text_size = ts)
    table.cell(reg, 2, 5, array.get(TER_TXT, terN0), text_size = ts)
    table.cell(reg, 3, 5, "", text_size = ts)
    table.cell(reg, 4, 5, "", text_size = ts)
    // 3 · Ruptura
    table.cell(reg, 0, 6, "3 · Ruptura", text_size = ts)
    table.cell(reg, 1, 6, dL0 == 0 ? "esperando" : brkL0, text_size = ts)
    table.cell(reg, 2, 6, dN0 == 0 ? "esperando" : brkN0, text_size = ts)
    table.cell(reg, 3, 6, "", text_size = ts)
    table.cell(reg, 4, 6, "", text_size = ts)
    for i = 1 to 6
        table.cell(reg, 0, 6 + i, "   " + array.get(EV_TXT, i), text_size = ts)
        table.cell(reg, 1, 6 + i, dL0 == 0 ? "—" : cellHoy(pev(cLon, terL0, i - 1), array.get(flgL0, i), true, doneL0), text_size = ts)
        table.cell(reg, 2, 6 + i, dN0 == 0 ? "—" : cellHoy(pev(cNy, terN0, i - 1), array.get(flgN0, i), true, doneN0), text_size = ts)
        table.cell(reg, 3, 6 + i, cellGraf(spL0, htL0, nL0, i), text_size = ts)
        table.cell(reg, 4, 6 + i, cellGraf(spN0, htN0, nN0, i), text_size = ts)
    table.cell(reg, 0, 13, "   Llega a 2.0 (si tocó 1.618)", text_size = ts)
    table.cell(reg, 1, 13, dL0 == 0 ? "—" : cell2Hoy(cLon, terL0, array.get(flgL0, 4), st2L, hit2L, doneL0), text_size = ts)
    table.cell(reg, 2, 13, dN0 == 0 ? "—" : cell2Hoy(cNy, terN0, array.get(flgN0, 4), st2N, hit2N, doneN0), text_size = ts)
    table.cell(reg, 3, 13, cell2Graf(s2L, h2L, n2L), text_size = ts)
    table.cell(reg, 4, 13, cell2Graf(s2N, h2N, n2N), text_size = ts)
    table.cell(reg, 0, 14, "Escenario", text_size = ts)
    table.cell(reg, 1, 14, doneL0 ? scL0 : dL0 == 0 ? "—" : "en curso", text_size = ts)
    table.cell(reg, 2, 14, doneN0 ? scN0 : dN0 == 0 ? "—" : "en curso", text_size = ts)
    table.cell(reg, 3, 14, "", text_size = ts)
    table.cell(reg, 4, 14, "", text_size = ts)

// Probabilidades medidas en el estudio (NAS100 + US500, 1 min, 2022-2026).
// Actualízalas con los valores de orb/results/dukascopy/REPORT.md si cambias datos o período.
if showDash and showStats and barstate.islast
    c0 = orMin == 15 ? 0 : 1
    c1 = orMin == 15 ? 2 : 3
    var table t = table.new(posOf(statsPos), 3, 9, bgcolor = color.new(color.gray, 90), border_width = 1)
    table.cell(t, 0, 0, "Tras la ruptura (OR " + str.tostring(orMin) + "m)", text_size = dashTs)
    table.cell(t, 1, 0, "Londres", text_size = dashTs)
    table.cell(t, 2, 0, "NY", text_size = dashTs)
    table.cell(t, 0, 1, "Retest del nivel roto", text_size = dashTs)
    table.cell(t, 1, 1, orMin == 15 ? "95%" : "95%", text_size = dashTs)
    table.cell(t, 2, 1, orMin == 15 ? "95%" : "95%", text_size = dashTs)
    table.cell(t, 0, 2, "Retrocede al 50%", text_size = dashTs)
    table.cell(t, 1, 2, orMin == 15 ? "73%" : "69%", text_size = dashTs)
    table.cell(t, 2, 2, orMin == 15 ? "72%" : "67%", text_size = dashTs)
    table.cell(t, 0, 3, "Toca el extremo opuesto", text_size = dashTs)
    table.cell(t, 1, 3, orMin == 15 ? "54%" : "48%", text_size = dashTs)
    table.cell(t, 2, 3, orMin == 15 ? "54%" : "48%", text_size = dashTs)
    table.cell(t, 0, 4, "Llega a 1.618", text_size = dashTs)
    table.cell(t, 1, 4, str.tostring(prob(c0, 3, 0), "#") + "%", text_size = dashTs)
    table.cell(t, 2, 4, str.tostring(prob(c1, 3, 0), "#") + "%", text_size = dashTs)
    table.cell(t, 0, 5, "  con rango pequeño / grande", text_size = dashTs)
    table.cell(t, 1, 5, str.tostring(prob(c0, 0, 0), "#") + "% / " + str.tostring(prob(c0, 2, 0), "#") + "%", text_size = dashTs)
    table.cell(t, 2, 5, str.tostring(prob(c1, 0, 0), "#") + "% / " + str.tostring(prob(c1, 2, 0), "#") + "%", text_size = dashTs)
    table.cell(t, 0, 6, "  si ya tocó el 50%", text_size = dashTs)
    table.cell(t, 1, 6, str.tostring(prob(c0, 3, 1), "#") + "%", text_size = dashTs)
    table.cell(t, 2, 6, str.tostring(prob(c1, 3, 1), "#") + "%", text_size = dashTs)
    table.cell(t, 0, 7, "  si ya tocó el extremo opuesto", text_size = dashTs)
    table.cell(t, 1, 7, str.tostring(prob(c0, 3, 2), "#") + "%", text_size = dashTs)
    table.cell(t, 2, 7, str.tostring(prob(c1, 3, 2), "#") + "%", text_size = dashTs)
    table.cell(t, 0, 8, "1.618 antes que 50%", text_size = dashTs)
    table.cell(t, 1, 8, orMin == 15 ? "53%" : "52%", text_size = dashTs)
    table.cell(t, 2, 8, orMin == 15 ? "53%" : "53%", text_size = dashTs)
